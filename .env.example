# Copy to `.env` and fill in real values (do NOT commit `.env`).
# Existing dev environment ----------------------------------------------------
GPU=0
DATA=/media/home

# PyPI publishing (motrack-pypi target only) ----------------------------------
PYPI_TOKEN=

# MLflow stack (docker/mlflow-stack.compose.yaml) -----------------------------
# Postgres backend store credentials.
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me-32-random-chars
POSTGRES_DB=mlflow

# MinIO artifact store credentials (root account).
# Generate two long random strings; treat MINIO_ROOT_PASSWORD like a DB password.
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-32-random-chars

# MLflow + MinIO ports (host-side). Keep MLFLOW_PORT=5000 to match clients.
MLFLOW_PORT=5000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
